# Kanagawa
# Dark colorscheme based on Kanagawa Wave for truecolor and 256-color terminals.

color-link default "#DCD7BA,#1F1F28"
color-link comment "italic #727169"
color-link todo "bold #E6C384,#363646"

color-link identifier "#7E9CD8"
color-link identifier.class "bold #E6C384"
color-link identifier.macro "#957FB8"
color-link identifier.var "#D27E99"

color-link constant "#FFA066"
color-link constant.bool "#FFA066"
color-link constant.bool.true "#98BB6C"
color-link constant.bool.false "#FF5D62"
color-link constant.number "#D27E99"
color-link constant.specialChar "#7FB4CA"
color-link constant.string "#98BB6C"
color-link constant.string.char "#7AA89F"
color-link constant.string.raw "#E6C384"
color-link constant.string.url "underline #7FB4CA"

color-link statement "bold #957FB8"
color-link preproc "bold #FF5D62"
color-link type "#7AA89F"
color-link type.keyword "bold #957FB8"
color-link type.extended "#7AA89F"
color-link special "#E6C384"

color-link symbol "#7AA89F"
color-link symbol.brackets "#C8C093"
color-link symbol.operator "#C0A36E"
color-link symbol.tag "#D27E99"
color-link symbol.math "#7FB4CA"
color-link conceal "bold #7AA89F"

color-link underlined "underline #7FB4CA"
color-link error "bold #FF5D62"
color-link ignore "#727169"

# Diagnostics & Gutter
color-link gutter-error "bold #FF5D62,#16161D"
color-link gutter-warning "bold #FF9E3B,#16161D"
color-link gutter-info "bold #7E9CD8,#16161D"

# UI Chrome
color-link line-number "#727169,#16161D"
color-link current-line-number "bold #DCD7BA,#2A2A37"
color-link cursor-line "#2A2A37"
color-link color-column "#2A2A37"
color-link selection "#1F1F28,#7E9CD8"
color-link hlsearch "#1F1F28,#E6C384"
color-link match-brace "bold #1F1F28,#7AA89F"

color-link statusline "#DCD7BA,#2A2A37"
color-link statusline.inactive "#727169,#16161D"
color-link statusline.suggestions "#1F1F28,#7FB4CA"
color-link statusline.dim "#727169,#2A2A37"
color-link statusline.ok "bold #98BB6C,#2A2A37"
color-link statusline.warn "bold #FF9E3B,#2A2A37"
color-link statusline.err "bold #1F1F28,#FF5D62"
color-link statusline.accent "bold #7AA89F,#2A2A37"
color-link statusline.mode.markup "bold #7E9CD8,#2A2A37"
color-link statusline.mode.math "bold #7FB4CA,#2A2A37"
color-link statusline.mode.code "bold #957FB8,#2A2A37"
color-link statusline.mode.raw "bold #FFA066,#2A2A37"
color-link bottombar "#C8C093,#16161D"
color-link bottombar.key "bold #7E9CD8,#2A2A37"
color-link bottombar.active "bold #1F1F28,#7AA89F"
color-link bottombar.badge "bold #1F1F28,#7E9CD8"
color-link bottombar.badge.math "bold #1F1F28,#7FB4CA"
color-link bottombar.badge.code "bold #1F1F28,#957FB8"
color-link bottombar.badge.raw "bold #1F1F28,#FFA066"
color-link bottombar.err "bold #1F1F28,#FF5D62"
color-link bottombar.warn "bold #1F1F28,#E6C384"
color-link bottombar.dim "#727169,#16161D"
color-link tabbar "#C8C093,#16161D"
color-link tabbar.active "bold #1F1F28,#7E9CD8"
color-link message "#DCD7BA,#16161D"
color-link error-message "bold #1F1F28,#FF5D62"
color-link divider "#54546D,#16161D"
color-link scrollbar "#54546D"

color-link indent-char "#363646"
color-link tab-error "#FF5D62"
color-link trailingws "#FF5D62"

color-link diff-added "#98BB6C"
color-link diff-modified "#E6C384"
color-link diff-deleted "#FF5D62"
