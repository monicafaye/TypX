# Tokyo Night
# Dark colorscheme based on Tokyo Night for truecolor and 256-color terminals.

color-link default "#C0CAF5,#1A1B26"
color-link comment "italic #565F89"
color-link todo "bold #E0AF68,#292E42"

color-link identifier "#7AA2F7"
color-link identifier.class "bold #E0AF68"
color-link identifier.macro "#BB9AF7"
color-link identifier.var "#C0CAF5"

color-link constant "#FF9E64"
color-link constant.bool "#FF9E64"
color-link constant.bool.true "#9ECE6A"
color-link constant.bool.false "#F7768E"
color-link constant.number "#FF9E64"
color-link constant.specialChar "#89DDFF"
color-link constant.string "#9ECE6A"
color-link constant.string.char "#73DACA"
color-link constant.string.raw "#E0AF68"
color-link constant.string.url "underline #7DCFFF"

color-link statement "bold #BB9AF7"
color-link preproc "bold #F7768E"
color-link type "#2AC3DE"
color-link type.keyword "bold #BB9AF7"
color-link type.extended "#2AC3DE"
color-link special "#E0AF68"

color-link symbol "#73DACA"
color-link symbol.brackets "#A9B1D6"
color-link symbol.operator "#89DDFF"
color-link symbol.tag "#F7768E"
color-link symbol.math "#7DCFFF"
color-link conceal "bold #73DACA"

color-link underlined "underline #7DCFFF"
color-link error "bold #F7768E"
color-link ignore "#565F89"

# Diagnostics & Gutter
color-link gutter-error "bold #F7768E,#16161E"
color-link gutter-warning "bold #E0AF68,#16161E"
color-link gutter-info "bold #7AA2F7,#16161E"

# UI Chrome
color-link line-number "#565F89,#16161E"
color-link current-line-number "bold #C0CAF5,#292E42"
color-link cursor-line "#292E42"
color-link color-column "#292E42"
color-link selection "#1A1B26,#7AA2F7"
color-link hlsearch "#1A1B26,#E0AF68"
color-link match-brace "bold #1A1B26,#73DACA"

color-link statusline "#C0CAF5,#24283B"
color-link statusline.inactive "#565F89,#16161E"
color-link statusline.suggestions "#1A1B26,#7DCFFF"
color-link statusline.dim "#565F89,#24283B"
color-link statusline.ok "bold #9ECE6A,#24283B"
color-link statusline.warn "bold #E0AF68,#24283B"
color-link statusline.err "bold #1A1B26,#F7768E"
color-link statusline.accent "bold #73DACA,#24283B"
color-link statusline.mode.markup "bold #7AA2F7,#24283B"
color-link statusline.mode.math "bold #7DCFFF,#24283B"
color-link statusline.mode.code "bold #BB9AF7,#24283B"
color-link statusline.mode.raw "bold #FF9E64,#24283B"
color-link bottombar "#A9B1D6,#16161E"
color-link bottombar.key "bold #7AA2F7,#24283B"
color-link bottombar.active "bold #1A1B26,#73DACA"
color-link bottombar.badge "bold #1A1B26,#7AA2F7"
color-link bottombar.badge.math "bold #1A1B26,#7DCFFF"
color-link bottombar.badge.code "bold #1A1B26,#BB9AF7"
color-link bottombar.badge.raw "bold #1A1B26,#FF9E64"
color-link bottombar.err "bold #1A1B26,#F7768E"
color-link bottombar.warn "bold #1A1B26,#E0AF68"
color-link bottombar.dim "#565F89,#16161E"
color-link tabbar "#A9B1D6,#16161E"
color-link tabbar.active "bold #1A1B26,#7AA2F7"
color-link message "#C0CAF5,#16161E"
color-link error-message "bold #1A1B26,#F7768E"
color-link divider "#3B4261,#16161E"
color-link scrollbar "#3B4261"

color-link indent-char "#3B4261"
color-link tab-error "#F7768E"
color-link trailingws "#F7768E"

color-link diff-added "#9ECE6A"
color-link diff-modified "#E0AF68"
color-link diff-deleted "#F7768E"
