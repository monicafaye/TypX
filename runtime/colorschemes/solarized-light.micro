# Solarized Light
# Light colorscheme based on Ethan Schoonover's Solarized Light for truecolor and 256-color terminals.

color-link default "#657B83,#FDF6E3"
color-link comment "italic #93A1A1"
color-link todo "bold #D33682,#EEE8D5"

color-link identifier "#268BD2"
color-link identifier.class "bold #B58900"
color-link identifier.macro "#6C71C4"
color-link identifier.var "#268BD2"

color-link constant "#2AA198"
color-link constant.bool "#2AA198"
color-link constant.bool.true "#859900"
color-link constant.bool.false "#DC322F"
color-link constant.number "#D33682"
color-link constant.specialChar "#CB4B16"
color-link constant.string "#2AA198"
color-link constant.string.char "#2AA198"
color-link constant.string.raw "#6C71C4"
color-link constant.string.url "underline #268BD2"

color-link statement "bold #859900"
color-link preproc "bold #CB4B16"
color-link type "#B58900"
color-link type.keyword "bold #859900"
color-link type.extended "#B58900"
color-link special "#CB4B16"

color-link symbol "#2AA198"
color-link symbol.brackets "#586E75"
color-link symbol.operator "#859900"
color-link symbol.tag "#268BD2"
color-link symbol.math "#268BD2"
color-link conceal "bold #2AA198"

color-link underlined "underline #268BD2"
color-link error "bold #DC322F"
color-link ignore "#93A1A1"

# Diagnostics & Gutter
color-link gutter-error "bold #DC322F,#EEE8D5"
color-link gutter-warning "bold #B58900,#EEE8D5"
color-link gutter-info "bold #268BD2,#EEE8D5"

# UI Chrome
color-link line-number "#93A1A1,#EEE8D5"
color-link current-line-number "bold #586E75,#E1DBCA"
color-link cursor-line "#EEE8D5"
color-link color-column "#EEE8D5"
color-link selection "#FDF6E3,#268BD2"
color-link hlsearch "#FDF6E3,#B58900"
color-link match-brace "bold #FDF6E3,#2AA198"

color-link statusline "#586E75,#E1DBCA"
color-link statusline.inactive "#93A1A1,#EEE8D5"
color-link statusline.suggestions "#FDF6E3,#268BD2"
color-link statusline.dim "#93A1A1,#E1DBCA"
color-link statusline.ok "bold #859900,#E1DBCA"
color-link statusline.warn "bold #B58900,#E1DBCA"
color-link statusline.err "bold #FDF6E3,#DC322F"
color-link statusline.accent "bold #2AA198,#E1DBCA"
color-link statusline.mode.markup "bold #268BD2,#E1DBCA"
color-link statusline.mode.math "bold #2AA198,#E1DBCA"
color-link statusline.mode.code "bold #6C71C4,#E1DBCA"
color-link statusline.mode.raw "bold #CB4B16,#E1DBCA"
color-link bottombar "#657B83,#EEE8D5"
color-link bottombar.key "bold #268BD2,#E1DBCA"
color-link bottombar.active "bold #FDF6E3,#2AA198"
color-link bottombar.badge "bold #FDF6E3,#268BD2"
color-link bottombar.badge.math "bold #FDF6E3,#2AA198"
color-link bottombar.badge.code "bold #FDF6E3,#6C71C4"
color-link bottombar.badge.raw "bold #FDF6E3,#CB4B16"
color-link bottombar.err "bold #FDF6E3,#DC322F"
color-link bottombar.warn "bold #FDF6E3,#B58900"
color-link bottombar.dim "#93A1A1,#EEE8D5"
color-link tabbar "#657B83,#EEE8D5"
color-link tabbar.active "bold #FDF6E3,#268BD2"
color-link message "#586E75,#EEE8D5"
color-link error-message "bold #FDF6E3,#DC322F"
color-link divider "#D3CCB9,#EEE8D5"
color-link scrollbar "#93A1A1"

color-link indent-char "#E1DBCA"
color-link tab-error "#DC322F"
color-link trailingws "#DC322F"

color-link diff-added "#859900"
color-link diff-modified "#B58900"
color-link diff-deleted "#DC322F"
