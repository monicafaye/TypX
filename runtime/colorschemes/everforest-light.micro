# Everforest Light
# Warm light colorscheme based on Everforest Light Medium for truecolor and 256-color terminals.

color-link default "#5C6A72,#FDF6E3"
color-link comment "italic #939F91"
color-link todo "bold #DFA000,#E6E2CC"

color-link identifier "#3A94C5"
color-link identifier.class "bold #DFA000"
color-link identifier.macro "#DF69BA"
color-link identifier.var "#5C6A72"

color-link constant "#F57D26"
color-link constant.bool "#DF69BA"
color-link constant.bool.true "#8DA101"
color-link constant.bool.false "#F85552"
color-link constant.number "#DF69BA"
color-link constant.specialChar "#35A77C"
color-link constant.string "#8DA101"
color-link constant.string.char "#35A77C"
color-link constant.string.raw "#F57D26"
color-link constant.string.url "underline #3A94C5"

color-link statement "bold #F85552"
color-link preproc "bold #DF69BA"
color-link type "#DFA000"
color-link type.keyword "bold #F85552"
color-link type.extended "#35A77C"
color-link special "#F57D26"

color-link symbol "#35A77C"
color-link symbol.brackets "#708089"
color-link symbol.operator "#F57D26"
color-link symbol.tag "#DF69BA"
color-link symbol.math "#3A94C5"
color-link conceal "bold #35A77C"

color-link underlined "underline #3A94C5"
color-link error "bold #F85552"
color-link ignore "#939F91"

# Diagnostics & Gutter
color-link gutter-error "bold #F85552,#EFEBD4"
color-link gutter-warning "bold #DFA000,#EFEBD4"
color-link gutter-info "bold #3A94C5,#EFEBD4"

# UI Chrome
color-link line-number "#939F91,#EFEBD4"
color-link current-line-number "bold #5C6A72,#E6E2CC"
color-link cursor-line "#F4F0D9"
color-link color-column "#F4F0D9"
color-link selection "#FDF6E3,#3A94C5"
color-link hlsearch "#5C6A72,#DFA000"
color-link match-brace "bold #FDF6E3,#35A77C"

color-link statusline "#5C6A72,#E6E2CC"
color-link statusline.inactive "#939F91,#EFEBD4"
color-link statusline.suggestions "#FDF6E3,#3A94C5"
color-link statusline.dim "#939F91,#E6E2CC"
color-link statusline.ok "bold #8DA101,#E6E2CC"
color-link statusline.warn "bold #F57D26,#E6E2CC"
color-link statusline.err "bold #FDF6E3,#F85552"
color-link statusline.accent "bold #35A77C,#E6E2CC"
color-link statusline.mode.markup "bold #8DA101,#E6E2CC"
color-link statusline.mode.math "bold #3A94C5,#E6E2CC"
color-link statusline.mode.code "bold #DF69BA,#E6E2CC"
color-link statusline.mode.raw "bold #F57D26,#E6E2CC"
color-link bottombar "#708089,#EFEBD4"
color-link bottombar.key "bold #3A94C5,#E6E2CC"
color-link bottombar.active "bold #FDF6E3,#35A77C"
color-link bottombar.badge "bold #FDF6E3,#8DA101"
color-link bottombar.badge.math "bold #FDF6E3,#3A94C5"
color-link bottombar.badge.code "bold #FDF6E3,#DF69BA"
color-link bottombar.badge.raw "bold #FDF6E3,#F57D26"
color-link bottombar.err "bold #FDF6E3,#F85552"
color-link bottombar.warn "bold #5C6A72,#DFA000"
color-link bottombar.dim "#939F91,#EFEBD4"
color-link tabbar "#708089,#EFEBD4"
color-link tabbar.active "bold #FDF6E3,#8DA101"
color-link message "#5C6A72,#EFEBD4"
color-link error-message "bold #FDF6E3,#F85552"
color-link divider "#BDC3AF,#EFEBD4"
color-link scrollbar "#BDC3AF"

color-link indent-char "#E0DCC7"
color-link tab-error "#F85552"
color-link trailingws "#F85552"

color-link diff-added "#8DA101"
color-link diff-modified "#DFA000"
color-link diff-deleted "#F85552"
