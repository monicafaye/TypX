# GitHub Dark
# High-contrast dark colorscheme based on GitHub Dark Default for truecolor and 256-color terminals.

color-link default "#E6EDF3,#0D1117"
color-link comment "italic #8B949E"
color-link todo "bold #D29922,#21262D"

color-link identifier "#79C0FF"
color-link identifier.class "bold #FFA657"
color-link identifier.macro "#D2A8FF"
color-link identifier.var "#D2A8FF"

color-link constant "#79C0FF"
color-link constant.bool "#79C0FF"
color-link constant.bool.true "#7EE787"
color-link constant.bool.false "#FF7B72"
color-link constant.number "#79C0FF"
color-link constant.specialChar "#FFA657"
color-link constant.string "#A5D6FF"
color-link constant.string.char "#7EE787"
color-link constant.string.raw "#D2A8FF"
color-link constant.string.url "underline #58A6FF"

color-link statement "bold #FF7B72"
color-link preproc "bold #FF7B72"
color-link type "#39C5CF"
color-link type.keyword "bold #FF7B72"
color-link type.extended "#39C5CF"
color-link special "#FFA657"

color-link symbol "#39C5CF"
color-link symbol.brackets "#C9D1D9"
color-link symbol.operator "#79C0FF"
color-link symbol.tag "#7EE787"
color-link symbol.math "#79C0FF"
color-link conceal "bold #39C5CF"

color-link underlined "underline #58A6FF"
color-link error "bold #F85149"
color-link ignore "#8B949E"

# Diagnostics & Gutter
color-link gutter-error "bold #F85149,#010409"
color-link gutter-warning "bold #D29922,#010409"
color-link gutter-info "bold #58A6FF,#010409"

# UI Chrome
color-link line-number "#6E7681,#010409"
color-link current-line-number "bold #E6EDF3,#21262D"
color-link cursor-line "#161B22"
color-link color-column "#161B22"
color-link selection "#0D1117,#58A6FF"
color-link hlsearch "#0D1117,#D29922"
color-link match-brace "bold #0D1117,#39C5CF"

color-link statusline "#E6EDF3,#161B22"
color-link statusline.inactive "#8B949E,#010409"
color-link statusline.suggestions "#0D1117,#58A6FF"
color-link statusline.dim "#6E7681,#161B22"
color-link statusline.ok "bold #56D364,#161B22"
color-link statusline.warn "bold #D29922,#161B22"
color-link statusline.err "bold #0D1117,#F85149"
color-link statusline.accent "bold #39C5CF,#161B22"
color-link statusline.mode.markup "bold #58A6FF,#161B22"
color-link statusline.mode.math "bold #39C5CF,#161B22"
color-link statusline.mode.code "bold #D2A8FF,#161B22"
color-link statusline.mode.raw "bold #FFA657,#161B22"
color-link bottombar "#C9D1D9,#010409"
color-link bottombar.key "bold #58A6FF,#161B22"
color-link bottombar.active "bold #0D1117,#39C5CF"
color-link bottombar.badge "bold #0D1117,#58A6FF"
color-link bottombar.badge.math "bold #0D1117,#39C5CF"
color-link bottombar.badge.code "bold #0D1117,#D2A8FF"
color-link bottombar.badge.raw "bold #0D1117,#FFA657"
color-link bottombar.err "bold #0D1117,#F85149"
color-link bottombar.warn "bold #0D1117,#D29922"
color-link bottombar.dim "#6E7681,#010409"
color-link tabbar "#C9D1D9,#010409"
color-link tabbar.active "bold #0D1117,#58A6FF"
color-link message "#E6EDF3,#010409"
color-link error-message "bold #0D1117,#F85149"
color-link divider "#30363D,#010409"
color-link scrollbar "#30363D"

color-link indent-char "#21262D"
color-link tab-error "#F85149"
color-link trailingws "#F85149"

color-link diff-added "#56D364"
color-link diff-modified "#D29922"
color-link diff-deleted "#F85149"
