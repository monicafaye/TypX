# Nord
# Arctic dark colorscheme based on Nord for truecolor and 256-color terminals.

color-link default "#D8DEE9,#2E3440"
color-link comment "italic #616E88"
color-link todo "bold #EBCB8B,#434C5E"

color-link identifier "#88C0D0"
color-link identifier.class "bold #EBCB8B"
color-link identifier.macro "#B48EAD"
color-link identifier.var "#ECEFF4"

color-link constant "#D08770"
color-link constant.bool "#D08770"
color-link constant.bool.true "#A3BE8C"
color-link constant.bool.false "#BF616A"
color-link constant.number "#B48EAD"
color-link constant.specialChar "#EBCB8B"
color-link constant.string "#A3BE8C"
color-link constant.string.char "#8FBCBB"
color-link constant.string.raw "#EBCB8B"
color-link constant.string.url "underline #88C0D0"

color-link statement "bold #81A1C1"
color-link preproc "bold #5E81AC"
color-link type "#8FBCBB"
color-link type.keyword "bold #81A1C1"
color-link type.extended "#8FBCBB"
color-link special "#EBCB8B"

color-link symbol "#8FBCBB"
color-link symbol.brackets "#D8DEE9"
color-link symbol.operator "#81A1C1"
color-link symbol.tag "#81A1C1"
color-link symbol.math "#88C0D0"
color-link conceal "bold #8FBCBB"

color-link underlined "underline #88C0D0"
color-link error "bold #BF616A"
color-link ignore "#616E88"

# Diagnostics & Gutter
color-link gutter-error "bold #BF616A,#272C36"
color-link gutter-warning "bold #EBCB8B,#272C36"
color-link gutter-info "bold #88C0D0,#272C36"

# UI Chrome
color-link line-number "#616E88,#272C36"
color-link current-line-number "bold #ECEFF4,#3B4252"
color-link cursor-line "#3B4252"
color-link color-column "#3B4252"
color-link selection "#2E3440,#88C0D0"
color-link hlsearch "#2E3440,#EBCB8B"
color-link match-brace "bold #2E3440,#8FBCBB"

color-link statusline "#E5E9F0,#3B4252"
color-link statusline.inactive "#616E88,#272C36"
color-link statusline.suggestions "#2E3440,#88C0D0"
color-link statusline.dim "#616E88,#3B4252"
color-link statusline.ok "bold #A3BE8C,#3B4252"
color-link statusline.warn "bold #EBCB8B,#3B4252"
color-link statusline.err "bold #ECEFF4,#BF616A"
color-link statusline.accent "bold #8FBCBB,#3B4252"
color-link statusline.mode.markup "bold #81A1C1,#3B4252"
color-link statusline.mode.math "bold #88C0D0,#3B4252"
color-link statusline.mode.code "bold #B48EAD,#3B4252"
color-link statusline.mode.raw "bold #D08770,#3B4252"
color-link bottombar "#D8DEE9,#272C36"
color-link bottombar.key "bold #88C0D0,#3B4252"
color-link bottombar.active "bold #2E3440,#8FBCBB"
color-link bottombar.badge "bold #2E3440,#81A1C1"
color-link bottombar.badge.math "bold #2E3440,#88C0D0"
color-link bottombar.badge.code "bold #2E3440,#B48EAD"
color-link bottombar.badge.raw "bold #2E3440,#D08770"
color-link bottombar.err "bold #ECEFF4,#BF616A"
color-link bottombar.warn "bold #2E3440,#EBCB8B"
color-link bottombar.dim "#616E88,#272C36"
color-link tabbar "#D8DEE9,#272C36"
color-link tabbar.active "bold #2E3440,#88C0D0"
color-link message "#E5E9F0,#272C36"
color-link error-message "bold #ECEFF4,#BF616A"
color-link divider "#4C566A,#272C36"
color-link scrollbar "#4C566A"

color-link indent-char "#434C5E"
color-link tab-error "#BF616A"
color-link trailingws "#BF616A"

color-link diff-added "#A3BE8C"
color-link diff-modified "#EBCB8B"
color-link diff-deleted "#BF616A"
