# Gruvbox Dark (Truecolor)
# Retro warm dark colorscheme based on Gruvbox Dark Medium with full TypX styling.

color-link default "#EBDBB2,#282828"
color-link comment "italic #928374"
color-link todo "bold #FABD2F,#504945"

color-link identifier "#83A598"
color-link identifier.class "bold #FABD2F"
color-link identifier.macro "#D3869B"
color-link identifier.var "#8EC07C"

color-link constant "#D3869B"
color-link constant.bool "#D3869B"
color-link constant.bool.true "#B8BB26"
color-link constant.bool.false "#FB4934"
color-link constant.number "#D3869B"
color-link constant.specialChar "#FE8019"
color-link constant.string "#B8BB26"
color-link constant.string.char "#8EC07C"
color-link constant.string.raw "#FE8019"
color-link constant.string.url "underline #83A598"

color-link statement "bold #FB4934"
color-link preproc "bold #8EC07C"
color-link type "#FABD2F"
color-link type.keyword "bold #FB4934"
color-link type.extended "#FABD2F"
color-link special "#FE8019"

color-link symbol "#8EC07C"
color-link symbol.brackets "#BDAE93"
color-link symbol.operator "#FE8019"
color-link symbol.tag "#D3869B"
color-link symbol.math "#83A598"
color-link conceal "bold #8EC07C"

color-link underlined "underline #83A598"
color-link error "bold #FB4934"
color-link ignore "#928374"

# Diagnostics & Gutter
color-link gutter-error "bold #FB4934,#1D2021"
color-link gutter-warning "bold #FABD2F,#1D2021"
color-link gutter-info "bold #83A598,#1D2021"

# UI Chrome
color-link line-number "#7C6F64,#1D2021"
color-link current-line-number "bold #FABD2F,#3C3836"
color-link cursor-line "#3C3836"
color-link color-column "#3C3836"
color-link selection "#282828,#83A598"
color-link hlsearch "#282828,#FABD2F"
color-link match-brace "bold #282828,#D3869B"

color-link statusline "#EBDBB2,#3C3836"
color-link statusline.inactive "#928374,#1D2021"
color-link statusline.suggestions "#282828,#83A598"
color-link statusline.dim "#928374,#3C3836"
color-link statusline.ok "bold #B8BB26,#3C3836"
color-link statusline.warn "bold #FABD2F,#3C3836"
color-link statusline.err "bold #282828,#FB4934"
color-link statusline.accent "bold #8EC07C,#3C3836"
color-link statusline.mode.markup "bold #83A598,#3C3836"
color-link statusline.mode.math "bold #8EC07C,#3C3836"
color-link statusline.mode.code "bold #D3869B,#3C3836"
color-link statusline.mode.raw "bold #FE8019,#3C3836"
color-link bottombar "#D5C4A1,#1D2021"
color-link bottombar.key "bold #83A598,#3C3836"
color-link bottombar.active "bold #282828,#B8BB26"
color-link bottombar.badge "bold #282828,#83A598"
color-link bottombar.badge.math "bold #282828,#8EC07C"
color-link bottombar.badge.code "bold #282828,#D3869B"
color-link bottombar.badge.raw "bold #282828,#FE8019"
color-link bottombar.err "bold #282828,#FB4934"
color-link bottombar.warn "bold #282828,#FABD2F"
color-link bottombar.dim "#7C6F64,#1D2021"
color-link tabbar "#D5C4A1,#1D2021"
color-link tabbar.active "bold #282828,#FABD2F"
color-link message "#EBDBB2,#1D2021"
color-link error-message "bold #282828,#FB4934"
color-link divider "#504945,#1D2021"
color-link scrollbar "#665C54"

color-link indent-char "#504945"
color-link tab-error "#FB4934"
color-link trailingws "#FB4934"

color-link diff-added "#B8BB26"
color-link diff-modified "#FABD2F"
color-link diff-deleted "#FB4934"
