# Solarized Dark (Truecolor)
# Ethan Schoonover's Solarized Dark colorscheme with full TypX syntax, conceal, and UI styling.

color-link default "#839496,#002B36"
color-link comment "italic #586E75"
color-link todo "bold #D33682,#073642"

color-link identifier "#268BD2"
color-link identifier.class "bold #B58900"
color-link identifier.macro "#6C71C4"
color-link identifier.var "#268BD2"

color-link constant "#2AA198"
color-link constant.bool "#2AA198"
color-link constant.bool.true "#859900"
color-link constant.bool.false "#DC322F"
color-link constant.number "#D33682"
color-link constant.specialChar "#CB4B16"
color-link constant.string "#2AA198"
color-link constant.string.char "#2AA198"
color-link constant.string.raw "#6C71C4"
color-link constant.string.url "underline #268BD2"

color-link statement "bold #859900"
color-link preproc "bold #CB4B16"
color-link type "#B58900"
color-link type.keyword "bold #859900"
color-link type.extended "#839496"
color-link special "#CB4B16"

color-link symbol "#2AA198"
color-link symbol.brackets "#93A1A1"
color-link symbol.operator "#859900"
color-link symbol.tag "#268BD2"
color-link symbol.math "#268BD2"
color-link conceal "bold #2AA198"

color-link underlined "underline #268BD2"
color-link error "bold #DC322F"
color-link ignore "#586E75"

# Diagnostics & Gutter
color-link gutter-error "bold #DC322F,#00212B"
color-link gutter-warning "bold #B58900,#00212B"
color-link gutter-info "bold #268BD2,#00212B"

# UI Chrome
color-link line-number "#586E75,#00212B"
color-link current-line-number "bold #93A1A1,#073642"
color-link cursor-line "#073642"
color-link color-column "#073642"
color-link selection "#002B36,#268BD2"
color-link hlsearch "#002B36,#B58900"
color-link match-brace "bold #002B36,#2AA198"

color-link statusline "#93A1A1,#073642"
color-link statusline.inactive "#586E75,#00212B"
color-link statusline.suggestions "#002B36,#268BD2"
color-link statusline.dim "#586E75,#073642"
color-link statusline.ok "bold #859900,#073642"
color-link statusline.warn "bold #B58900,#073642"
color-link statusline.err "bold #FDF6E3,#DC322F"
color-link statusline.accent "bold #2AA198,#073642"
color-link statusline.mode.markup "bold #268BD2,#073642"
color-link statusline.mode.math "bold #2AA198,#073642"
color-link statusline.mode.code "bold #6C71C4,#073642"
color-link statusline.mode.raw "bold #CB4B16,#073642"
color-link bottombar "#839496,#00212B"
color-link bottombar.key "bold #268BD2,#073642"
color-link bottombar.active "bold #002B36,#2AA198"
color-link bottombar.badge "bold #002B36,#268BD2"
color-link bottombar.badge.math "bold #002B36,#2AA198"
color-link bottombar.badge.code "bold #FDF6E3,#6C71C4"
color-link bottombar.badge.raw "bold #FDF6E3,#CB4B16"
color-link bottombar.err "bold #FDF6E3,#DC322F"
color-link bottombar.warn "bold #002B36,#B58900"
color-link bottombar.dim "#586E75,#00212B"
color-link tabbar "#839496,#00212B"
color-link tabbar.active "bold #002B36,#268BD2"
color-link message "#93A1A1,#00212B"
color-link error-message "bold #FDF6E3,#DC322F"
color-link divider "#586E75,#00212B"
color-link scrollbar "#586E75"

color-link indent-char "#073642"
color-link tab-error "#DC322F"
color-link trailingws "#DC322F"

color-link diff-added "#859900"
color-link diff-modified "#B58900"
color-link diff-deleted "#DC322F"
