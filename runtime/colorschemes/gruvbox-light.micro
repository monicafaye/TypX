# Gruvbox Light
# Retro warm light colorscheme based on Gruvbox Light Medium for truecolor and 256-color terminals.

color-link default "#3C3836,#FBF1C7"
color-link comment "italic #928374"
color-link todo "bold #B57614,#EBDBB2"

color-link identifier "#076678"
color-link identifier.class "bold #B57614"
color-link identifier.macro "#8F3F71"
color-link identifier.var "#427B58"

color-link constant "#8F3F71"
color-link constant.bool "#8F3F71"
color-link constant.bool.true "#79740E"
color-link constant.bool.false "#9D0006"
color-link constant.number "#8F3F71"
color-link constant.specialChar "#AF3A03"
color-link constant.string "#79740E"
color-link constant.string.char "#427B58"
color-link constant.string.raw "#AF3A03"
color-link constant.string.url "underline #076678"

color-link statement "bold #9D0006"
color-link preproc "bold #427B58"
color-link type "#B57614"
color-link type.keyword "bold #9D0006"
color-link type.extended "#B57614"
color-link special "#AF3A03"

color-link symbol "#427B58"
color-link symbol.brackets "#665C54"
color-link symbol.operator "#AF3A03"
color-link symbol.tag "#8F3F71"
color-link symbol.math "#076678"
color-link conceal "bold #427B58"

color-link underlined "underline #076678"
color-link error "bold #9D0006"
color-link ignore "#928374"

# Diagnostics & Gutter
color-link gutter-error "bold #9D0006,#F2E5BC"
color-link gutter-warning "bold #B57614,#F2E5BC"
color-link gutter-info "bold #076678,#F2E5BC"

# UI Chrome
color-link line-number "#928374,#F2E5BC"
color-link current-line-number "bold #3C3836,#D5C4A1"
color-link cursor-line "#EBDBB2"
color-link color-column "#EBDBB2"
color-link selection "#FBF1C7,#076678"
color-link hlsearch "#3C3836,#FABD2F"
color-link match-brace "bold #FBF1C7,#427B58"

color-link statusline "#3C3836,#D5C4A1"
color-link statusline.inactive "#7C6F64,#F2E5BC"
color-link statusline.suggestions "#FBF1C7,#076678"
color-link statusline.dim "#7C6F64,#D5C4A1"
color-link statusline.ok "bold #79740E,#D5C4A1"
color-link statusline.warn "bold #AF3A03,#D5C4A1"
color-link statusline.err "bold #FBF1C7,#9D0006"
color-link statusline.accent "bold #427B58,#D5C4A1"
color-link statusline.mode.markup "bold #076678,#D5C4A1"
color-link statusline.mode.math "bold #427B58,#D5C4A1"
color-link statusline.mode.code "bold #8F3F71,#D5C4A1"
color-link statusline.mode.raw "bold #AF3A03,#D5C4A1"
color-link bottombar "#504945,#F2E5BC"
color-link bottombar.key "bold #076678,#D5C4A1"
color-link bottombar.active "bold #FBF1C7,#427B58"
color-link bottombar.badge "bold #FBF1C7,#076678"
color-link bottombar.badge.math "bold #FBF1C7,#427B58"
color-link bottombar.badge.code "bold #FBF1C7,#8F3F71"
color-link bottombar.badge.raw "bold #FBF1C7,#AF3A03"
color-link bottombar.err "bold #FBF1C7,#9D0006"
color-link bottombar.warn "bold #3C3836,#FABD2F"
color-link bottombar.dim "#7C6F64,#F2E5BC"
color-link tabbar "#504945,#F2E5BC"
color-link tabbar.active "bold #FBF1C7,#076678"
color-link message "#3C3836,#F2E5BC"
color-link error-message "bold #FBF1C7,#9D0006"
color-link divider "#BDAE93,#F2E5BC"
color-link scrollbar "#A89984"

color-link indent-char "#D5C4A1"
color-link tab-error "#9D0006"
color-link trailingws "#9D0006"

color-link diff-added "#79740E"
color-link diff-modified "#B57614"
color-link diff-deleted "#9D0006"
