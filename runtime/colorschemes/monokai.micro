# Monokai (default)
# Classic Monokai colorscheme with full TypX syntax, conceal, and UI styling.

color-link default "#F8F8F2,#282828"
color-link comment "italic #75715E"
color-link todo "bold #E6DB74,#49483E"

color-link identifier "#66D9EF"
color-link identifier.class "bold #A6E22E"
color-link identifier.macro "#AE81FF"
color-link identifier.var "#FD971F"

color-link constant "#AE81FF"
color-link constant.bool "#AE81FF"
color-link constant.bool.true "#A6E22E"
color-link constant.bool.false "#F92672"
color-link constant.number "#AE81FF"
color-link constant.specialChar "#FD971F"
color-link constant.string "#E6DB74"
color-link constant.string.char "#BDE6AD"
color-link constant.string.raw "#FD971F"
color-link constant.string.url "underline #66D9EF"

color-link statement "bold #F92672"
color-link preproc "bold #FD971F"
color-link type "#66D9EF"
color-link type.keyword "bold #F92672"
color-link type.extended "default"
color-link special "#A6E22E"

color-link symbol "#66D9EF"
color-link symbol.brackets "#F8F8F2"
color-link symbol.operator "#F92672"
color-link symbol.tag "#AE81FF"
color-link symbol.math "#66D9EF"
color-link conceal "bold #A6E22E"

color-link underlined "underline #66D9EF"
color-link error "bold #F92672"
color-link ignore "#75715E"

# Diagnostics & Gutter
color-link gutter-error "bold #F92672,#1E1F1C"
color-link gutter-warning "bold #E6DB74,#1E1F1C"
color-link gutter-info "bold #66D9EF,#1E1F1C"

# UI Chrome
color-link line-number "#75715E,#1E1F1C"
color-link current-line-number "bold #F8F8F2,#3E3D32"
color-link cursor-line "#323232"
color-link color-column "#323232"
color-link selection "#282828,#E6DB74"
color-link hlsearch "#282828,#E6DB74"
color-link match-brace "bold #282828,#AE81FF"

color-link statusline "#F8F8F2,#3E3D32"
color-link statusline.inactive "#75715E,#1E1F1C"
color-link statusline.suggestions "#282828,#66D9EF"
color-link statusline.dim "#75715E,#3E3D32"
color-link statusline.ok "bold #A6E22E,#3E3D32"
color-link statusline.warn "bold #E6DB74,#3E3D32"
color-link statusline.err "bold #F8F8F2,#F92672"
color-link statusline.accent "bold #66D9EF,#3E3D32"
color-link statusline.mode.markup "bold #66D9EF,#3E3D32"
color-link statusline.mode.math "bold #A6E22E,#3E3D32"
color-link statusline.mode.code "bold #AE81FF,#3E3D32"
color-link statusline.mode.raw "bold #FD971F,#3E3D32"
color-link bottombar "#CFCFC2,#1E1F1C"
color-link bottombar.key "bold #66D9EF,#3E3D32"
color-link bottombar.active "bold #282828,#A6E22E"
color-link bottombar.badge "bold #282828,#66D9EF"
color-link bottombar.badge.math "bold #282828,#A6E22E"
color-link bottombar.badge.code "bold #282828,#AE81FF"
color-link bottombar.badge.raw "bold #282828,#FD971F"
color-link bottombar.err "bold #F8F8F2,#F92672"
color-link bottombar.warn "bold #282828,#E6DB74"
color-link bottombar.dim "#75715E,#1E1F1C"
color-link tabbar "#CFCFC2,#1E1F1C"
color-link tabbar.active "bold #282828,#A6E22E"
color-link message "#F8F8F2,#1E1F1C"
color-link error-message "bold #F8F8F2,#F92672"
color-link divider "#49483E,#1E1F1C"
color-link scrollbar "#49483E"

color-link indent-char "#49483E"
color-link tab-error "#F92672"
color-link trailingws "#F92672"

color-link diff-added "#A6E22E"
color-link diff-modified "#E6DB74"
color-link diff-deleted "#F92672"
