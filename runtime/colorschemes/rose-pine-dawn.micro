# Rose Pine Dawn
# Warm light colorscheme based on Rose Pine Dawn for truecolor and 256-color terminals.

color-link default "#575279,#FAF4ED"
color-link comment "italic #9893A5"
color-link todo "bold #EA9D34,#F2E9E1"

color-link identifier "#286983"
color-link identifier.class "bold #EA9D34"
color-link identifier.macro "#907AA9"
color-link identifier.var "#D7827E"

color-link constant "#D7827E"
color-link constant.bool "#D7827E"
color-link constant.bool.true "#56949F"
color-link constant.bool.false "#B4637A"
color-link constant.number "#EA9D34"
color-link constant.specialChar "#D7827E"
color-link constant.string "#EA9D34"
color-link constant.string.char "#56949F"
color-link constant.string.raw "#907AA9"
color-link constant.string.url "underline #286983"

color-link statement "bold #907AA9"
color-link preproc "bold #B4637A"
color-link type "#56949F"
color-link type.keyword "bold #907AA9"
color-link type.extended "#56949F"
color-link special "#D7827E"

color-link symbol "#56949F"
color-link symbol.brackets "#797593"
color-link symbol.operator "#286983"
color-link symbol.tag "#B4637A"
color-link symbol.math "#286983"
color-link conceal "bold #56949F"

color-link underlined "underline #286983"
color-link error "bold #B4637A"
color-link ignore "#9893A5"

# Diagnostics & Gutter
color-link gutter-error "bold #B4637A,#F2E9E1"
color-link gutter-warning "bold #EA9D34,#F2E9E1"
color-link gutter-info "bold #286983,#F2E9E1"

# UI Chrome
color-link line-number "#9893A5,#F2E9E1"
color-link current-line-number "bold #575279,#DFDAD9"
color-link cursor-line "#F2E9E1"
color-link color-column "#F2E9E1"
color-link selection "#FAF4ED,#907AA9"
color-link hlsearch "#575279,#EA9D34"
color-link match-brace "bold #FAF4ED,#56949F"

color-link statusline "#575279,#DFDAD9"
color-link statusline.inactive "#9893A5,#F2E9E1"
color-link statusline.suggestions "#FAF4ED,#286983"
color-link statusline.dim "#9893A5,#DFDAD9"
color-link statusline.ok "bold #56949F,#DFDAD9"
color-link statusline.warn "bold #EA9D34,#DFDAD9"
color-link statusline.err "bold #FAF4ED,#B4637A"
color-link statusline.accent "bold #286983,#DFDAD9"
color-link statusline.mode.markup "bold #286983,#DFDAD9"
color-link statusline.mode.math "bold #56949F,#DFDAD9"
color-link statusline.mode.code "bold #907AA9,#DFDAD9"
color-link statusline.mode.raw "bold #D7827E,#DFDAD9"
color-link bottombar "#797593,#F2E9E1"
color-link bottombar.key "bold #286983,#DFDAD9"
color-link bottombar.active "bold #FAF4ED,#56949F"
color-link bottombar.badge "bold #FAF4ED,#286983"
color-link bottombar.badge.math "bold #FAF4ED,#56949F"
color-link bottombar.badge.code "bold #FAF4ED,#907AA9"
color-link bottombar.badge.raw "bold #FAF4ED,#D7827E"
color-link bottombar.err "bold #FAF4ED,#B4637A"
color-link bottombar.warn "bold #575279,#EA9D34"
color-link bottombar.dim "#9893A5,#F2E9E1"
color-link tabbar "#797593,#F2E9E1"
color-link tabbar.active "bold #FAF4ED,#286983"
color-link message "#575279,#F2E9E1"
color-link error-message "bold #FAF4ED,#B4637A"
color-link divider "#CECACD,#F2E9E1"
color-link scrollbar "#CECACD"

color-link indent-char "#DFDAD9"
color-link tab-error "#B4637A"
color-link trailingws "#B4637A"

color-link diff-added "#56949F"
color-link diff-modified "#EA9D34"
color-link diff-deleted "#B4637A"
