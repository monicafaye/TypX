# Catppuccin Latte
# High-contrast light colorscheme based on Catppuccin Latte for truecolor and 256-color terminals.

color-link default "#4C4F69,#EFF1F5"
color-link comment "italic #8C8FA1"
color-link todo "bold #DF8E1D,#DCE0E8"

color-link identifier "#1E66F5"
color-link identifier.class "bold #DF8E1D"
color-link identifier.macro "#8839EF"
color-link identifier.var "#EA76CB"

color-link constant "#FE640B"
color-link constant.bool "#FE640B"
color-link constant.bool.true "#40A02B"
color-link constant.bool.false "#D20F39"
color-link constant.number "#FE640B"
color-link constant.specialChar "#DC8A78"
color-link constant.string "#40A02B"
color-link constant.string.char "#179299"
color-link constant.string.raw "#8839EF"
color-link constant.string.url "underline #04A5E5"

color-link statement "bold #8839EF"
color-link preproc "bold #D20F39"
color-link type "#179299"
color-link type.keyword "bold #8839EF"
color-link type.extended "#179299"
color-link special "#FE640B"

color-link symbol "#179299"
color-link symbol.brackets "#6C6F85"
color-link symbol.operator "#04A5E5"
color-link symbol.tag "#EA76CB"
color-link symbol.math "#209FB5"
color-link conceal "bold #179299"

color-link underlined "underline #04A5E5"
color-link error "bold #D20F39"
color-link ignore "#8C8FA1"

# Diagnostics & Gutter
color-link gutter-error "bold #D20F39,#E6E9EF"
color-link gutter-warning "bold #DF8E1D,#E6E9EF"
color-link gutter-info "bold #1E66F5,#E6E9EF"

# UI Chrome
color-link line-number "#8C8FA1,#E6E9EF"
color-link current-line-number "bold #4C4F69,#DCE0E8"
color-link cursor-line "#E6E9EF"
color-link color-column "#E6E9EF"
color-link selection "#EFF1F5,#1E66F5"
color-link hlsearch "#4C4F69,#DF8E1D"
color-link match-brace "bold #EFF1F5,#179299"

color-link statusline "#4C4F69,#DCE0E8"
color-link statusline.inactive "#8C8FA1,#E6E9EF"
color-link statusline.suggestions "#EFF1F5,#1E66F5"
color-link statusline.dim "#8C8FA1,#DCE0E8"
color-link statusline.ok "bold #40A02B,#DCE0E8"
color-link statusline.warn "bold #DF8E1D,#DCE0E8"
color-link statusline.err "bold #EFF1F5,#D20F39"
color-link statusline.accent "bold #179299,#DCE0E8"
color-link statusline.mode.markup "bold #1E66F5,#DCE0E8"
color-link statusline.mode.math "bold #209FB5,#DCE0E8"
color-link statusline.mode.code "bold #8839EF,#DCE0E8"
color-link statusline.mode.raw "bold #FE640B,#DCE0E8"
color-link bottombar "#5C5F77,#E6E9EF"
color-link bottombar.key "bold #1E66F5,#DCE0E8"
color-link bottombar.active "bold #EFF1F5,#179299"
color-link bottombar.badge "bold #EFF1F5,#1E66F5"
color-link bottombar.badge.math "bold #EFF1F5,#209FB5"
color-link bottombar.badge.code "bold #EFF1F5,#8839EF"
color-link bottombar.badge.raw "bold #EFF1F5,#FE640B"
color-link bottombar.err "bold #EFF1F5,#D20F39"
color-link bottombar.warn "bold #4C4F69,#DF8E1D"
color-link bottombar.dim "#8C8FA1,#E6E9EF"
color-link tabbar "#5C5F77,#E6E9EF"
color-link tabbar.active "bold #EFF1F5,#1E66F5"
color-link message "#4C4F69,#E6E9EF"
color-link error-message "bold #EFF1F5,#D20F39"
color-link divider "#ACB0BE,#E6E9EF"
color-link scrollbar "#ACB0BE"

color-link indent-char "#CCD0DA"
color-link tab-error "#D20F39"
color-link trailingws "#D20F39"

color-link diff-added "#40A02B"
color-link diff-modified "#DF8E1D"
color-link diff-deleted "#D20F39"
