# Everforest Dark
# Warm forest dark colorscheme based on Everforest Medium for truecolor and 256-color terminals.

color-link default "#D3C6AA,#2D353B"
color-link comment "italic #859289"
color-link todo "bold #DBBC7F,#475258"

color-link identifier "#7FBBB3"
color-link identifier.class "bold #DBBC7F"
color-link identifier.macro "#D699B6"
color-link identifier.var "#D3C6AA"

color-link constant "#E69875"
color-link constant.bool "#D699B6"
color-link constant.bool.true "#A7C080"
color-link constant.bool.false "#E67E80"
color-link constant.number "#D699B6"
color-link constant.specialChar "#83C092"
color-link constant.string "#A7C080"
color-link constant.string.char "#83C092"
color-link constant.string.raw "#DBBC7F"
color-link constant.string.url "underline #7FBBB3"

color-link statement "bold #E67E80"
color-link preproc "bold #D699B6"
color-link type "#DBBC7F"
color-link type.keyword "bold #E67E80"
color-link type.extended "#83C092"
color-link special "#E69875"

color-link symbol "#83C092"
color-link symbol.brackets "#9DA9A0"
color-link symbol.operator "#E69875"
color-link symbol.tag "#D699B6"
color-link symbol.math "#7FBBB3"
color-link conceal "bold #83C092"

color-link underlined "underline #7FBBB3"
color-link error "bold #E67E80"
color-link ignore "#859289"

# Diagnostics & Gutter
color-link gutter-error "bold #E67E80,#232A2E"
color-link gutter-warning "bold #DBBC7F,#232A2E"
color-link gutter-info "bold #7FBBB3,#232A2E"

# UI Chrome
color-link line-number "#859289,#232A2E"
color-link current-line-number "bold #D3C6AA,#3D484D"
color-link cursor-line "#343F44"
color-link color-column "#343F44"
color-link selection "#2D353B,#A7C080"
color-link hlsearch "#2D353B,#DBBC7F"
color-link match-brace "bold #2D353B,#83C092"

color-link statusline "#D3C6AA,#3D484D"
color-link statusline.inactive "#859289,#232A2E"
color-link statusline.suggestions "#2D353B,#7FBBB3"
color-link statusline.dim "#859289,#3D484D"
color-link statusline.ok "bold #A7C080,#3D484D"
color-link statusline.warn "bold #DBBC7F,#3D484D"
color-link statusline.err "bold #2D353B,#E67E80"
color-link statusline.accent "bold #83C092,#3D484D"
color-link statusline.mode.markup "bold #A7C080,#3D484D"
color-link statusline.mode.math "bold #7FBBB3,#3D484D"
color-link statusline.mode.code "bold #D699B6,#3D484D"
color-link statusline.mode.raw "bold #E69875,#3D484D"
color-link bottombar "#9DA9A0,#232A2E"
color-link bottombar.key "bold #A7C080,#3D484D"
color-link bottombar.active "bold #2D353B,#83C092"
color-link bottombar.badge "bold #2D353B,#A7C080"
color-link bottombar.badge.math "bold #2D353B,#7FBBB3"
color-link bottombar.badge.code "bold #2D353B,#D699B6"
color-link bottombar.badge.raw "bold #2D353B,#E69875"
color-link bottombar.err "bold #2D353B,#E67E80"
color-link bottombar.warn "bold #2D353B,#DBBC7F"
color-link bottombar.dim "#859289,#232A2E"
color-link tabbar "#9DA9A0,#232A2E"
color-link tabbar.active "bold #2D353B,#A7C080"
color-link message "#D3C6AA,#232A2E"
color-link error-message "bold #2D353B,#E67E80"
color-link divider "#4F585E,#232A2E"
color-link scrollbar "#4F585E"

color-link indent-char "#475258"
color-link tab-error "#E67E80"
color-link trailingws "#E67E80"

color-link diff-added "#A7C080"
color-link diff-modified "#DBBC7F"
color-link diff-deleted "#E67E80"
