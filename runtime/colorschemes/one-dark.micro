# One Dark
# Atom One Dark colorscheme with full TypX syntax, conceal, and UI styling.

color-link default "#ABB2BF,#21252B"
color-link comment "italic #5C6370"
color-link todo "bold #E5C07B,#3E4451"

color-link identifier "#61AFEF"
color-link identifier.class "bold #E5C07B"
color-link identifier.macro "#C678DD"
color-link identifier.var "#E06C75"

color-link constant "#D19A66"
color-link constant.bool "#D19A66"
color-link constant.bool.true "#98C379"
color-link constant.bool.false "#E06C75"
color-link constant.number "#D19A66"
color-link constant.specialChar "#56B6C2"
color-link constant.string "#98C379"
color-link constant.string.char "#56B6C2"
color-link constant.string.raw "#E5C07B"
color-link constant.string.url "underline #61AFEF"

color-link statement "bold #C678DD"
color-link preproc "bold #E06C75"
color-link type "#56B6C2"
color-link type.keyword "bold #C678DD"
color-link type.extended "#56B6C2"
color-link special "#E5C07B"

color-link symbol "#56B6C2"
color-link symbol.brackets "#ABB2BF"
color-link symbol.operator "#56B6C2"
color-link symbol.tag "#E06C75"
color-link symbol.math "#61AFEF"
color-link conceal "bold #56B6C2"

color-link underlined "underline #61AFEF"
color-link error "bold #E06C75"
color-link ignore "#5C6370"

# Diagnostics & Gutter
color-link gutter-error "bold #E06C75,#1B1F27"
color-link gutter-warning "bold #E5C07B,#1B1F27"
color-link gutter-info "bold #61AFEF,#1B1F27"

# UI Chrome
color-link line-number "#636D83,#1B1F27"
color-link current-line-number "bold #ABB2BF,#2C313C"
color-link cursor-line "#282C34"
color-link color-column "#282C34"
color-link selection "#21252B,#61AFEF"
color-link hlsearch "#21252B,#E5C07B"
color-link match-brace "bold #21252B,#C678DD"

color-link statusline "#ABB2BF,#2C313C"
color-link statusline.inactive "#636D83,#1B1F27"
color-link statusline.suggestions "#21252B,#61AFEF"
color-link statusline.dim "#5C6370,#2C313C"
color-link statusline.ok "bold #98C379,#2C313C"
color-link statusline.warn "bold #E5C07B,#2C313C"
color-link statusline.err "bold #21252B,#E06C75"
color-link statusline.accent "bold #56B6C2,#2C313C"
color-link statusline.mode.markup "bold #61AFEF,#2C313C"
color-link statusline.mode.math "bold #56B6C2,#2C313C"
color-link statusline.mode.code "bold #C678DD,#2C313C"
color-link statusline.mode.raw "bold #D19A66,#2C313C"
color-link bottombar "#ABB2BF,#1B1F27"
color-link bottombar.key "bold #61AFEF,#2C313C"
color-link bottombar.active "bold #21252B,#98C379"
color-link bottombar.badge "bold #21252B,#61AFEF"
color-link bottombar.badge.math "bold #21252B,#56B6C2"
color-link bottombar.badge.code "bold #21252B,#C678DD"
color-link bottombar.badge.raw "bold #21252B,#D19A66"
color-link bottombar.err "bold #21252B,#E06C75"
color-link bottombar.warn "bold #21252B,#E5C07B"
color-link bottombar.dim "#5C6370,#1B1F27"
color-link tabbar "#ABB2BF,#1B1F27"
color-link tabbar.active "bold #21252B,#61AFEF"
color-link message "#ABB2BF,#1B1F27"
color-link error-message "bold #21252B,#E06C75"
color-link divider "#3E4451,#1B1F27"
color-link scrollbar "#4B5263"

color-link indent-char "#3E4451"
color-link tab-error "#E06C75"
color-link trailingws "#E06C75"

color-link diff-added "#98C379"
color-link diff-modified "#E5C07B"
color-link diff-deleted "#E06C75"
