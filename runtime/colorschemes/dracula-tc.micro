# Dracula (Truecolor)
# Dracula dark colorscheme with full TypX syntax, conceal, and UI styling.

color-link default "#F8F8F2,#282A36"
color-link comment "italic #6272A4"
color-link todo "bold #FFB86C,#44475A"

color-link identifier "#50FA7B"
color-link identifier.class "bold #8BE9FD"
color-link identifier.macro "#BD93F9"
color-link identifier.var "#F8F8F2"

color-link constant "#BD93F9"
color-link constant.bool "#BD93F9"
color-link constant.bool.true "#50FA7B"
color-link constant.bool.false "#FF5555"
color-link constant.number "#BD93F9"
color-link constant.specialChar "#FFB86C"
color-link constant.string "#F1FA8C"
color-link constant.string.char "#8BE9FD"
color-link constant.string.raw "#FFB86C"
color-link constant.string.url "underline #8BE9FD"

color-link statement "bold #FF79C6"
color-link preproc "bold #FF79C6"
color-link type "italic #8BE9FD"
color-link type.keyword "bold #FF79C6"
color-link type.extended "default"
color-link special "#FFB86C"

color-link symbol "#FF79C6"
color-link symbol.brackets "#F8F8F2"
color-link symbol.operator "#FF79C6"
color-link symbol.tag "#BD93F9"
color-link symbol.math "#8BE9FD"
color-link conceal "bold #50FA7B"

color-link underlined "underline #8BE9FD"
color-link error "bold #FF5555"
color-link ignore "#6272A4"

# Diagnostics & Gutter
color-link gutter-error "bold #FF5555,#21222C"
color-link gutter-warning "bold #F1FA8C,#21222C"
color-link gutter-info "bold #8BE9FD,#21222C"

# UI Chrome
color-link line-number "#6272A4,#21222C"
color-link current-line-number "bold #F8F8F2,#44475A"
color-link cursor-line "#44475A"
color-link color-column "#44475A"
color-link selection "#282A36,#BD93F9"
color-link hlsearch "#282A36,#50FA7B"
color-link match-brace "bold #282A36,#FF79C6"

color-link statusline "#F8F8F2,#44475A"
color-link statusline.inactive "#6272A4,#21222C"
color-link statusline.suggestions "#282A36,#8BE9FD"
color-link statusline.dim "#6272A4,#44475A"
color-link statusline.ok "bold #50FA7B,#44475A"
color-link statusline.warn "bold #F1FA8C,#44475A"
color-link statusline.err "bold #F8F8F2,#FF5555"
color-link statusline.accent "bold #8BE9FD,#44475A"
color-link statusline.mode.markup "bold #BD93F9,#44475A"
color-link statusline.mode.math "bold #8BE9FD,#44475A"
color-link statusline.mode.code "bold #FF79C6,#44475A"
color-link statusline.mode.raw "bold #FFB86C,#44475A"
color-link bottombar "#F8F8F2,#21222C"
color-link bottombar.key "bold #8BE9FD,#44475A"
color-link bottombar.active "bold #282A36,#50FA7B"
color-link bottombar.badge "bold #282A36,#BD93F9"
color-link bottombar.badge.math "bold #282A36,#8BE9FD"
color-link bottombar.badge.code "bold #282A36,#FF79C6"
color-link bottombar.badge.raw "bold #282A36,#FFB86C"
color-link bottombar.err "bold #F8F8F2,#FF5555"
color-link bottombar.warn "bold #282A36,#F1FA8C"
color-link bottombar.dim "#6272A4,#21222C"
color-link tabbar "#F8F8F2,#21222C"
color-link tabbar.active "bold #282A36,#BD93F9"
color-link message "#F8F8F2,#21222C"
color-link error-message "bold #F8F8F2,#FF5555"
color-link divider "#6272A4,#21222C"
color-link scrollbar "#6272A4"

color-link indent-char "#44475A"
color-link tab-error "#FF5555"
color-link trailingws "#FF5555"

color-link diff-added "#50FA7B"
color-link diff-modified "#FFB86C"
color-link diff-deleted "#FF5555"
