# Rose Pine
# Dark colorscheme based on Rose Pine for truecolor and 256-color terminals.

color-link default "#E0DEF4,#191724"
color-link comment "italic #6E6A86"
color-link todo "bold #F6C177,#403D52"

color-link identifier "#9CCFD8"
color-link identifier.class "bold #F6C177"
color-link identifier.macro "#C4A7E7"
color-link identifier.var "#EBBCBA"

color-link constant "#EBBCBA"
color-link constant.bool "#EBBCBA"
color-link constant.bool.true "#9CCFD8"
color-link constant.bool.false "#EB6F92"
color-link constant.number "#F6C177"
color-link constant.specialChar "#EBBCBA"
color-link constant.string "#F6C177"
color-link constant.string.char "#9CCFD8"
color-link constant.string.raw "#EBBCBA"
color-link constant.string.url "underline #9CCFD8"

color-link statement "bold #C4A7E7"
color-link preproc "bold #EB6F92"
color-link type "#9CCFD8"
color-link type.keyword "bold #C4A7E7"
color-link type.extended "#9CCFD8"
color-link special "#F6C177"

color-link symbol "#9CCFD8"
color-link symbol.brackets "#908CAA"
color-link symbol.operator "#31748F"
color-link symbol.tag "#EBBCBA"
color-link symbol.math "#9CCFD8"
color-link conceal "bold #EBBCBA"

color-link underlined "underline #9CCFD8"
color-link error "bold #EB6F92"
color-link ignore "#6E6A86"

# Diagnostics & Gutter
color-link gutter-error "bold #EB6F92,#1F1D2E"
color-link gutter-warning "bold #F6C177,#1F1D2E"
color-link gutter-info "bold #9CCFD8,#1F1D2E"

# UI Chrome
color-link line-number "#6E6A86,#1F1D2E"
color-link current-line-number "bold #E0DEF4,#26233A"
color-link cursor-line "#26233A"
color-link color-column "#26233A"
color-link selection "#191724,#C4A7E7"
color-link hlsearch "#191724,#F6C177"
color-link match-brace "bold #191724,#9CCFD8"

color-link statusline "#E0DEF4,#26233A"
color-link statusline.inactive "#6E6A86,#1F1D2E"
color-link statusline.suggestions "#191724,#9CCFD8"
color-link statusline.dim "#6E6A86,#26233A"
color-link statusline.ok "bold #9CCFD8,#26233A"
color-link statusline.warn "bold #F6C177,#26233A"
color-link statusline.err "bold #191724,#EB6F92"
color-link statusline.accent "bold #EBBCBA,#26233A"
color-link statusline.mode.markup "bold #9CCFD8,#26233A"
color-link statusline.mode.math "bold #EBBCBA,#26233A"
color-link statusline.mode.code "bold #C4A7E7,#26233A"
color-link statusline.mode.raw "bold #F6C177,#26233A"
color-link bottombar "#908CAA,#1F1D2E"
color-link bottombar.key "bold #9CCFD8,#26233A"
color-link bottombar.active "bold #191724,#EBBCBA"
color-link bottombar.badge "bold #191724,#9CCFD8"
color-link bottombar.badge.math "bold #191724,#EBBCBA"
color-link bottombar.badge.code "bold #191724,#C4A7E7"
color-link bottombar.badge.raw "bold #191724,#F6C177"
color-link bottombar.err "bold #191724,#EB6F92"
color-link bottombar.warn "bold #191724,#F6C177"
color-link bottombar.dim "#6E6A86,#1F1D2E"
color-link tabbar "#908CAA,#1F1D2E"
color-link tabbar.active "bold #191724,#C4A7E7"
color-link message "#E0DEF4,#1F1D2E"
color-link error-message "bold #191724,#EB6F92"
color-link divider "#403D52,#1F1D2E"
color-link scrollbar "#524F67"

color-link indent-char "#403D52"
color-link tab-error "#EB6F92"
color-link trailingws "#EB6F92"

color-link diff-added "#9CCFD8"
color-link diff-modified "#F6C177"
color-link diff-deleted "#EB6F92"
